{
  "expo": {
    "name": "WordLadder",
    "slug": "wordladder",
    "version": "2.0.0",
    "scheme": "wordladder",
    "orientation": "portrait",
    "icon": "./assets/WL.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "785b674b-120a-4948-832d-898826a35fa1"
      }
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.vlad.wordLadder",
      "buildNumber": "49",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:wordladderpuzzlegame.com"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1",
            "extraPodfileProperties": {
              "SWIFT_VERSION": "5"
            }
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1200,
          "resizeMode": "cover"
        }
      ],
      "expo-font",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This allows Word Ladder to show you relevant ads and helps keep the game free."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/WL.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-audio"
    ],
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.vlad.wordLadderAndroid",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/ic_launcher-playstore.png",
        "backgroundColor": "#a1fcbc"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "com.google.android.gms.permission.AD_ID"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wordladderpuzzlegame.com",
              "pathPrefix": "/share"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "vladfantasyfootball"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5826991812725211~3233115456",
    "ios_app_id": "ca-app-pub-5826991812725211~5820606577"
  }
}
