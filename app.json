{
  "expo": {
    "name": "WordLadder",
    "slug": "wordladder",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/WL.png",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "785b674b-120a-4948-832d-898826a35fa1"
      }
    },
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "bundleIdentifier": "com.vlad.wordLadder",
      "buildNumber": "32",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1200,
          "resizeMode": "cover"
        }
      ],
      "expo-font",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "This allows Word Ladder to show you relevant ads and helps keep the game free."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/WL.png",
          "color": "#ffffff",
          "sounds": []
        }
      ],
      "expo-tracking-transparency"
    ],
    "android": {
      "googleServicesFile": "./google-services.json",
      "package": "com.vlad.wordLadderAndroid",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "vladfantasyfootball"
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-5826991812725211~3233115456",
    "ios_app_id": "ca-app-pub-5826991812725211~5820606577"
  }
}
